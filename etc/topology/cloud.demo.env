# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_agentstudio_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_agentstudio_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
SDKWORK_AGENTSTUDIO_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_AGENTSTUDIO_PROFILE_ID=cloud.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AGENTSTUDIO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

VITE_SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_AGENTSTUDIO_RUNTIME_TARGET=browser
SDKWORK_AGENTSTUDIO_ACCELERATOR_PROFILE=cpu


SDKWORK_CORS_ALLOWED_ORIGINS=https://agentstudio-demo.sdkwork.com,http://agentstudio-demo.sdkwork.com,https://agentstudio-demo.birdcoder.com,http://agentstudio-demo.birdcoder.com,https://agentstudio-demo.dtupay.com,http://agentstudio-demo.dtupay.com,https://agentstudio-demo.noaper.com,http://agentstudio-demo.noaper.com,https://agentstudio-demo.sdkwork.cn,http://agentstudio-demo.sdkwork.cn,https://agentstudio-demo.birdcoder.cn,http://agentstudio-demo.birdcoder.cn,https://agentstudio-demo.dtupay.cn,http://agentstudio-demo.dtupay.cn,https://agentstudio-demo.noaper.cn,http://agentstudio-demo.noaper.cn,https://agentstudio-demo.skubc.com,http://agentstudio-demo.skubc.com,https://agentstudio-demo.skubc.cn,http://agentstudio-demo.skubc.cn,https://agentstudio-demo.zowalk.com,http://agentstudio-demo.zowalk.com,https://agentstudio-demo.zowalk.cn,http://agentstudio-demo.zowalk.cn,https://agentstudio-demo.offer86.com,http://agentstudio-demo.offer86.com,https://agentstudio-demo.offer86.cn,http://agentstudio-demo.offer86.cn,https://agentstudio-demo.86offer.com,http://agentstudio-demo.86offer.com,https://agentstudio-demo.86offer.cn,http://agentstudio-demo.86offer.cn,https://agentstudio-app-demo.sdkwork.com,http://agentstudio-app-demo.sdkwork.com,https://agentstudio-app-demo.birdcoder.com,http://agentstudio-app-demo.birdcoder.com,https://agentstudio-app-demo.dtupay.com,http://agentstudio-app-demo.dtupay.com,https://agentstudio-app-demo.noaper.com,http://agentstudio-app-demo.noaper.com,https://agentstudio-app-demo.sdkwork.cn,http://agentstudio-app-demo.sdkwork.cn,https://agentstudio-app-demo.birdcoder.cn,http://agentstudio-app-demo.birdcoder.cn,https://agentstudio-app-demo.dtupay.cn,http://agentstudio-app-demo.dtupay.cn,https://agentstudio-app-demo.noaper.cn,http://agentstudio-app-demo.noaper.cn,https://agentstudio-app-demo.skubc.com,http://agentstudio-app-demo.skubc.com,https://agentstudio-app-demo.skubc.cn,http://agentstudio-app-demo.skubc.cn,https://agentstudio-app-demo.zowalk.com