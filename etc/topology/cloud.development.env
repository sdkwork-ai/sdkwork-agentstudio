SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
SDKWORK_AGENTSTUDIO_ENVIRONMENT=development
SDKWORK_AGENTSTUDIO_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AGENTSTUDIO_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

VITE_SDKWORK_AGENTSTUDIO_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
VITE_SDKWORK_AGENTSTUDIO_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_AGENTSTUDIO_RUNTIME_TARGET=browser
SDKWORK_AGENTSTUDIO_ACCELERATOR_PROFILE=cpu


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
