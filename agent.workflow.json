{
  "$schema": "https://sdkwork.com/schemas/workflow.spec.v1.json",
  "targets": [
    {
      "id": "web-universal-cloud-browser-zip",
      "packageId": "web-universal-cloud-browser-zip",
      "profileBinding": "fixed",
      "deploymentProfile": "cloud",
      "runtimeTarget": "browser",
      "targetPlatform": "web",
      "clientArchitecture": "pc-web",
      "profile": "browser",
      "platform": "web",
      "architecture": "universal",
      "formats": [
        "zip"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/web/**"
      ]
    },
    {
      "id": "windows-x64-standalone-desktop-zip",
      "packageId": "windows-x64-standalone-desktop-zip",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop",
      "targetPlatform": "windows",
      "clientArchitecture": "tauri",
      "profile": "desktop",
      "platform": "windows",
      "architecture": "x64",
      "formats": [
        "zip"
      ],
      "runner": "windows-2022",
      "outputGlobs": [
        "dist/desktop/*.msi"
      ]
    },
    {
      "id": "macos-universal-standalone-desktop-dmg",
      "packageId": "macos-universal-standalone-desktop-dmg",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop",
      "targetPlatform": "macos",
      "clientArchitecture": "tauri",
      "profile": "desktop",
      "platform": "macos",
      "architecture": "universal",
      "formats": [
        "dmg"
      ],
      "runner": "macos-14",
      "outputGlobs": [
        "dist/desktop/*.dmg"
      ]
    },
    {
      "id": "linux-x64-standalone-desktop-appimage",
      "packageId": "linux-x64-standalone-desktop-appimage",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "desktop",
      "targetPlatform": "linux",
      "clientArchitecture": "tauri",
      "profile": "desktop",
      "platform": "linux",
      "architecture": "x64",
      "formats": [
        "appimage"
      ],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/desktop/*.AppImage"
      ]
    }
  ],
  "dependencies": [
    {
      "id": "sdkwork-app-topology",
      "repository": "sdkwork-ai/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-appbase",
      "repository": "sdkwork-ai/sdkwork-appbase",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-core",
      "repository": "sdkwork-ai/sdkwork-core",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "sdkwork-ai/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "sdkwork-ai/sdkwork-drive",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "sdkwork-ai/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-im",
      "repository": "sdkwork-ai/sdkwork-im",
      "refInput": "SDKWORK_IM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-local-router",
      "repository": "sdkwork-ai/sdkwork-local-router",
      "refInput": "SDKWORK_LOCAL_ROUTER_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-messaging",
      "repository": "sdkwork-ai/sdkwork-messaging",
      "refInput": "SDKWORK_MESSAGING_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-rtc",
      "repository": "sdkwork-ai/sdkwork-rtc",
      "refInput": "SDKWORK_RTC_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-commons",
      "repository": "sdkwork-ai/sdkwork-sdk-commons",
      "refInput": "SDKWORK_SDK_COMMONS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-ui",
      "repository": "sdkwork-ai/sdkwork-ui",
      "refInput": "SDKWORK_UI_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "sdkwork-ai/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "sdkwork-ai/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "app": {
    "id": "sdkwork-agentstudio",
    "repository": "sdkwork-ai/sdkwork-agentstudio"
  },
  "release": {
    "artifactPrefix": "sdkwork-agentstudio",
    "defaultVersion": "0.1.0"
  }
}
